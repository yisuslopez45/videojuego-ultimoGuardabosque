/* Paleta de bosque */
:root {
    --verde-oscuro: rgb(28, 38, 30);
    --verde: rgb(46, 62, 48);
    --verde-claro: rgb(70, 92, 70);
    --madera: rgb(122, 84, 52);
    --dorado: rgb(222, 180, 82);
    --texto: rgb(236, 228, 210);
    --texto-suave: rgb(176, 168, 150);
}

.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
    align-items: center;
    justify-content: center;
}

.panel {
    width: 820px;
    height: 560px;
    background-color: var(--verde-oscuro);
    border-width: 3px;
    border-color: var(--madera);
    border-radius: 12px;
    padding: 20px 24px;
}

.header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
}

.title {
    font-size: 32px;
    -unity-font-style: bold;
    color: var(--texto);
}

.tabs {
    flex-direction: row;
}

.tab {
    font-size: 18px;
    color: var(--texto-suave);
    background-color: var(--verde);
    border-width: 2px;
    border-color: var(--verde-claro);
    border-radius: 6px;
    padding: 6px 18px;
    margin-left: 8px;
}

.tab:hover {
    background-color: var(--verde-claro);
}

.tab--active {
    color: var(--texto);
    border-color: var(--dorado);
    background-color: var(--verde-claro);
}

.scroll {
    flex-grow: 1;
}

.grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.slot {
    width: 140px;
    height: 160px;
    margin: 8px;
    padding: 8px;
    background-color: var(--verde);
    border-width: 2px;
    border-color: var(--verde-claro);
    border-radius: 8px;
    align-items: center;
    justify-content: space-between;
}

.slot:hover {
    background-color: var(--verde-claro);
    border-color: var(--texto-suave);
}

.slot--equipped {
    border-color: var(--dorado);
    border-width: 3px;
    background-color: rgb(64, 78, 52);
}

.slot-icon {
    width: 110px;
    height: 100px;
    -unity-background-scale-mode: scale-to-fit;
}

.slot-empty-icon {
    font-size: 44px;
    color: var(--texto-suave);
    -unity-text-align: middle-center;
    width: 110px;
    height: 100px;
}

.slot-name {
    font-size: 15px;
    color: var(--texto);
    -unity-text-align: middle-center;
    white-space: normal;
}

.slot-badge {
    position: absolute;
    top: 4px;
    right: 6px;
    font-size: 12px;
    color: var(--dorado);
    -unity-font-style: bold;
}

.footer {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 12px;
    padding-top: 10px;
    border-top-width: 1px;
    border-color: var(--verde-claro);
}

.footer-text {
    font-size: 16px;
    color: var(--texto);
}

.footer-hint {
    font-size: 14px;
    color: var(--texto-suave);
}
